			if (a % 400 == 0) {    //년도가 400로 나누어 떨어지면 윤년
				printf("leap year");
			}
			else {
				printf("common year");
			}
		}
		else {
			printf("leap year");
		}
	}
	else {
		printf("common year");
	}
	

